{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "llama3.2-harness:3b": {
          "name": "Llama 3.2 3B local",
          "limit": {
            "context": 16384,
            "output": 1024
          }
        }
      }
    }
  }
}
