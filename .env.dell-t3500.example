# dell-T3500 cluster-adapted configuration for google-research/harness2
# Active ports on dell-T3500: :8443 (n8n), :8765 (FastMCP), :8790 (occupied python svc), :11434 (Ollama)
# Use :8795 if starting harness2-bridge for Codex (--substrate cx).

# Option A: Local / Ollama OpenAI-compatible via OpenCode (export OPENCODE_CONFIG=/home/user/src/harness2/opencode.dell_t3500.json)
HARNESS2_SOLVER_MODEL=ollama-local/deepseek-v4.1-flash:cloud
HARNESS2_IMPROVER_MODEL=ollama-local/glm-5.3-flash:cloud
HARNESS2_JUDGE_MODEL=deepseek-v4.1-flash:cloud
HARNESS2_JUDGE_BASE_URL=http://127.0.0.1:11434/v1
HARNESS2_JUDGE_API_KEY=ollama
HARNESS2_RUNS_DIR=/home/user/src/harness2/runs/dell_t3500_ollama

# Option B: Vertex AI (requires gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global
# HARNESS2_SOLVER_MODEL=google-vertex/gemini-2.5-flash
# HARNESS2_IMPROVER_MODEL=google-vertex/gemini-2.5-flash
# HARNESS2_JUDGE_MODEL=gemini-2.5-flash
# HARNESS2_CODEX_BASE_URL=http://127.0.0.1:8795/v1
